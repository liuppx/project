# Copy this file to .env. Never commit .env or put production secrets here.
# Runtime settings belong here; SMTP and other business settings are managed
# by the administrator in the web console.

# Application identity and runtime mode.
TIMEZONE=Asia/Shanghai

APP_NAME="夜莺"
APP_ENV=local
APP_RUNTIME=local
APP_KEY=
APP_DEBUG=true
APP_SCHEME=auto
APP_URL=http://localhost:2222
APP_PORT=2222

# Browser-accessible PlantUML base URL. Keep empty to leave plantuml/puml
# blocks as code. For private deployments, expose an internal PlantUML Server
# through the same origin, for example /plantuml, instead of using a public URL.
# If directly using plantuml/plantuml-server:jetty on 127.0.0.1:18080, use
# http://127.0.0.1:18080 without a /plantuml suffix.
PLANTUML_SERVER_URL=

# OnlyOffice Docs integration.
# Production usually keeps OFFICE_PUBLIC_API_URL empty and proxies /office/
# through the Project public origin. Host-run local development can point it
# directly at a standalone Document Server.
OFFICE_ENABLED=
OFFICE_PUBLIC_API_URL=
# URL that OnlyOffice Document Server can use to call Project APIs.
# Container deployment default: http://nginx/api
# Docker Desktop + host-run Project example: http://host.docker.internal:2222/api
OFFICE_INTERNAL_API_BASE=http://nginx/api
# URL that Project can use to download edited files from OnlyOffice callback URLs.
# Container deployment default: http://nginx
# Host-run local development example: http://127.0.0.1:18088
OFFICE_INTERNAL_DOCUMENT_BASE=http://nginx

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Laravel storage directory. Leave empty to use the project's storage directory.
# Production may set one stable absolute directory shared by all releases,
# for example /var/lib/project/storage.
LOCAL_STORAGE_DIR=

# MySQL connection. Point these values at a MySQL service reachable from
# the host; this project does not start a local MySQL container.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=project
DB_USERNAME=project
DB_PASSWORD=123456
DB_PREFIX=pre_

# Manticore search endpoint. Search-dependent features require it to be
# reachable; the application can still boot while it is unavailable.
SEARCH_HOST=127.0.0.1
SEARCH_PORT=9306

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

# Redis connection. Point these values at a Redis service reachable from
# the host; this project does not start a local Redis container.
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

# Optional SMTP fallback. The administrator database setting `emailSetting`
# has higher priority, field by field. These values are used only when the
# corresponding database value is empty. Do not commit real credentials.
# Port 465 uses SMTPS; port 587 uses SMTP/STARTTLS.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="夜莺"


# Laravel filesystem remains local unless this is explicitly changed to s3.
FILESYSTEM_DRIVER=local

# Persistent uploads: local or s3. A deployment must use one persistent backend at a time.
FILE_STORAGE_DISK=local

# S3-compatible storage. For a Warehouse credential scoped to
# /services/project, use bucket=services and prefix=project.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=
# S3 API endpoint, for example http://127.0.0.1:6066 for a local Warehouse.
S3_ENDPOINT=
# Public URL used only when generating object URLs. Leave empty for a private Warehouse endpoint.
S3_URL=
# Put the bucket in the URL path (/services/key). Warehouse requires path-style access.
S3_PATH_STYLE=true

# Optional Node Pusher bridge. Project's built-in task/message realtime sync
# uses LaravelS WebSocket and does not require these values. Fill them only
# when publishing selected cross-app events to Node Pusher; verify with
# `php artisan pusher:smoke`.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
# Optional standard Pusher-compatible Node endpoint. Leave empty to use the
# default Pusher Cloud endpoint selected by the SDK.
PUSHER_APP_HOST=
PUSHER_APP_PORT=443
PUSHER_APP_SCHEME=https

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# LaravelS/Swoole listener. Keep it on loopback when Nginx is the public edge.
LARAVELS_LISTEN_IP=127.0.0.1
LARAVELS_LISTEN_PORT=2222
LARAVELS_INOTIFY_RELOAD=false
LARAVELS_HANDLE_STATIC=true

# Agent Runtime endpoints for host-run LaravelS. Project only forwards
# AppStore-compatible requests; Agent owns install/upgrade/rollback/uninstall.
AGENT_INTERNAL_URL=http://127.0.0.1:3900
AGENT_INSTANCE_ID=project
# Must match Agent config HUB_INTERNAL_TOKEN in agent/config/hub.env.
AGENT_INTERNAL_TOKEN=

# Legacy compatibility names. Keep empty unless an old runtime still reads them.
APPSTORE_INTERNAL_URL=
APPSTORE_ENTRY_URL=http://127.0.0.1:19080/internal?language={system_lang}&theme={system_theme}
APPSTORE_INSTANCE_ID=project
APPSTORE_AGENT_ID=project-agent-runtime
APPSTORE_AGENT_TOKEN=
# Runtime implementation. The YeYing community build uses the built-in runtime
# and does not require an external .so file.
RUNTIME_DRIVER=yeying
# 本机直跑默认不带 AI 网关。后续如把 AI 插件单独暴露到宿主机，再按实际地址填写。
AI_INTERNAL_URL=http://127.0.0.1:19081

# 在线授权默认仍走中央服务；如社区部署自己的授权服务，再覆盖此项。
ONLINE_LICENSE_APPSTORE_URL=https://appstore.yeying.pub

# YeYing Passport / Node identity authorization. Set this to a
# browser/phone-visible Node origin when enabling passport QR login, for
# example https://node.yeying.pub.
# Local phone scan needs a LAN IP/domain, not localhost.
IDENTITY_NODE_URL=
# Directory containing the Node issuer metadata, JWKS, and manifest bundle.
# Production default: /data/node. Local macOS development uses the synchronized bundle.
IDENTITY_TRUST_DIR=${HOME}/.config/node
# Fill with the Project application's AppId (applications.uid UUID) from Node.
IDENTITY_CLIENT_ID=
IDENTITY_SCOPE="identity.basic identity.username identity.email identity.wallet identity.avatar"
